# アプリケーション実行用の環境変数テンプレート
# 使い方: cp .env.example .env して値を埋める（.env は .gitignore 済み）
# 起動時に godotenv が .env を読み込む（main.go: firstSetup）

# === 必須 ===

# JWT署名鍵。未設定だと起動時に config.init() の log.Fatal で即終了する。
# 十分に長いランダム文字列を設定すること（例: openssl rand -hex 32）
JWT_SECRET_KEY=replace-with-a-long-random-secret

# Supabase(PostgreSQL) 接続URL。
# 末尾の "?sslmode=require" はコード側(supabase/client.go)が自動付与するため不要。
SUPABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# CORS 許可オリジン（カンマ区切り）。ブラウザのフロントエンドからアクセスする場合に必須。
# 例: フロントが localhost:3000 の場合
ALLOWED_ORIGINS=http://localhost:3000

# === 任意 ===

# 実行環境。"production" のとき Cookie が Secure=true / SameSite=None になる。
# ローカル開発では空（未設定）のままにする（Secure=false / SameSite=Lax）。
ENV=

# サーバーのリッスンポート。未設定の場合は 8080。
PORT=8080

# ログ抑制フラグ。"true" のとき INFO/ERROR/WARN/DEBUG ログを破棄する（主にテスト用）。
# TEST_MODE=true
