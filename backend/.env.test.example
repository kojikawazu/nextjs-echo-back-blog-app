# テスト実行用の環境変数テンプレート
# 使い方: cp .env.test.example .env.test して値を埋める（.env.test は .gitignore 済み）
#
# Repository 層の IT（インテグレーションテスト）は、既定では testcontainers が
# 使い捨ての PostgreSQL コンテナを起動するため、このファイルは不要。
#   実行: go test -tags=integration ./repositories/...（Docker 稼働が前提）
#
# 実 DB（実 Supabase 等）に対して IT を実行したい場合のみ、SUPABASE_URL と
# TEST_* を「環境変数として」渡す（testsupport は .env ファイルを自動読み込みしない）。
#   例: env $(grep -v '^#' .env.test | xargs) go test -tags=integration ./repositories/...
#
# Service / Handler 層のテストはモックを使うため DB 接続は不要。

# JWT署名鍵。Service/Handler テストで config パッケージが要求する。
JWT_SECRET_KEY=test-secret-key

# --- 以下は「実 DB に対して IT を実行する」場合のみ必要 ---

# 実 DB 接続URL。指定されている場合、IT は testcontainers を使わずこの DB に接続する。
# 本番DBではなくテスト用DBを指定すること（テストはデータを変更する）。
SUPABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# SSL モード（未設定時 "require"）。非SSLのテストDBなら "disable"。
# DB_SSLMODE=require

# 実 DB 側に用意した既知データに対応する値（testcontainers 使用時は自動設定されるため不要）。
TEST_USER_ID=00000000-0000-0000-0000-000000000000
TEST_USER_NAME=Test User
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWD=test-password
TEST_BLOG_ID=00000000-0000-0000-0000-000000000000
